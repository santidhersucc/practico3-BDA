# Copiar a .env para cambiar valores (opcional: si no existe, se usan estos mismos valores por defecto).
# No contiene credenciales: el MongoDB local no usa autenticación.

# Puerto de tu PC donde se publica MongoDB (solo accesible desde tu máquina)
MONGO_PORT=27017

# Puerto de tu PC donde se publica la API (Swagger en http://localhost:8000/docs)
API_PORT=8000

# Base de datos que usa la API
MONGO_DB=sentinel

# Año de la numeración de tickets: INC-AAAA-NNNNNN
ANIO_NUMERACION=2026
